%% Documentation framework for Data & AI projects, v1.0
%%
%% What this diagram shows: the flow and the gates. Nothing else.
%% Which artifact each phase produces is in FRAMEWORK.md §5, and what each
%% artifact answers is in §7. Repeating them here would put the same fact in
%% two places, which is the one thing the framework forbids. Node labels carry
%% artifact codes only, as a reminder, never their descriptions.
%%
%% The platform artifacts (AGENTS, OPEN, COMMITMENTS, GLOSSARY, PLATFORM,
%% decisions/, product.yaml) are deliberately absent: they are alive at every
%% moment and belong to no step, so drawing them here would mean drawing a box
%% with no edges. See FRAMEWORK.md §4.
%%
%% Three things the earlier version had wrong or missing, worth keeping right:
%% build comes before evaluation, reshaping comes before the cycle plan, and a
%% failed release gate is rework rather than rollback.

flowchart TD

  subgraph A["BLOCK A · DISCOVERY&nbsp;&nbsp;·&nbsp;&nbsp;per initiative, walked once"]
    direction TB

    F1["<b>F1 · Signal and framing</b><br/>PRB · HYP"]
    G1{"<b>G1</b><br/>Does the signal deserve<br/>investigation time?"}
    X1["Archive<br/><i>DEC: not pursued</i>"]

    F2["<b>F2 · Problem discovery</b><br/>WF §current · EVD"]
    G2{"<b>G2</b><br/>Real, recurring,<br/>costly?"}
    X2["Stop or reframe<br/><i>DEC + new HYP</i>"]

    F3["<b>F3 · Solution discovery</b><br/>WF §target · CMP · DFB · RSK"]
    G3{"<b>G3</b><br/>Desirable, viable,<br/>feasible, responsible?"}
    X3["Stop or pivot<br/><i>DEC + data gap recorded</i>"]

    F1 --> G1
    G1 -->|no| X1
    G1 -->|yes| F2
    F2 --> G2
    G2 -->|no| X2
    G2 -->|yes| F3
    F3 --> G3
    G3 -->|no| X3
  end

  subgraph B["BLOCK B · SHAPING&nbsp;&nbsp;·&nbsp;&nbsp;per product"]
    direction TB

    F4["<b>F4 · Shaping MVP and MVA</b><br/>PBR · SD · EVP · DC · RMP · DEC"]
    G4{"<b>G4 · Ready to build</b><br/>Are product, architecture and plan<br/>defined enough to start building?"}

    F4 --> G4
    G4 -->|"no · finish the shaping"| F4
  end

  subgraph C["BLOCK C · OPERATION AND EVOLUTION&nbsp;&nbsp;·&nbsp;&nbsp;continuous loop, per product"]
    direction TB

    BUILD["<b>Build · release candidate</b><br/>ARC, alive from here · code"]
    RG{"<b>RG · Release gate</b> <i>(recurring)</i><br/>Are the thresholds of the<br/>frozen EVP met?"}
    DEPLOY["<b>Deploy</b><br/>EVR · REL · RLM<br/><i>first time round, also RB</i>"]
    RUN["<b>Run and observe</b><br/>LOG"]
    INTAKE["<b>Change intake</b><br/>signals from LOG · increments from RMP"]
    TRIAGE["<b>Triage and impact assessment</b>"]
    ICG{"<b>ICG · Impact classification</b> <i>(recurring)</i><br/>Does it change product, architecture,<br/>data, evaluation or risk?"}
    RESHAPE["<b>Product and architecture reshaping</b><br/>PBR · WF · ARC · EVP · DC · RSK · RMP · DEC"]
    CHG["<b>Change contract</b><br/>CHG"]
    IMP["<b>Cycle implementation plan</b><br/>IMP"]

    BUILD --> RG
    RG -->|"no · <b>rework</b>, not rollback:<br/>it is not in production yet"| BUILD
    RG -->|yes| DEPLOY
    DEPLOY --> RUN
    RUN --> INTAKE
    INTAKE --> TRIAGE
    TRIAGE --> ICG
    ICG -->|"no structural impact"| CHG
    ICG -->|"product · architecture · both"| RESHAPE
    RESHAPE --> CHG
    CHG --> IMP
    IMP --> BUILD
  end

  G3 -->|yes| F4
  G4 -->|yes| BUILD

  MOR{"<b>MOR · MVP outcome review</b><br/><i>once, after the first period of real use</i><br/>Which assumptions did use confirm<br/>or disprove?"}

  %% Re entry paths. Dashed because they leave the loop instead of advancing it,
  %% and because a solid arrow back into F2 would read as a normal step.
  RUN -.->|once| MOR
  MOR -.->|continue| INTAKE
  MOR -.->|"solution hypothesis invalidated"| F3
  MOR -.->|"problem invalidated"| F2
  ICG -.->|"solution hypothesis invalidated"| F3
  ICG -.->|"problem or segment invalidated"| F2
  RUN -.->|"production regression:<br/>roll back, then re enter through LOG"| INTAKE
  RUN -.->|"signal opening a new initiative"| F1

  classDef phase     fill:#ffffff,stroke:#334155,stroke-width:2px,color:#0f172a
  classDef gate      fill:#fefce8,stroke:#ca8a04,stroke-width:2px,color:#422006
  classDef recurring fill:#faf5ff,stroke:#7e22ce,stroke-width:2px,color:#3b0764
  classDef stop      fill:#fef2f2,stroke:#b91c1c,stroke-width:1.5px,color:#450a0a

  class F1,F2,F3,F4,BUILD,DEPLOY,RUN,INTAKE,TRIAGE,RESHAPE,CHG,IMP phase
  class G1,G2,G3,G4,MOR gate
  class RG,ICG recurring
  class X1,X2,X3 stop

  %% Every gate leaves a DEC behind. A gate with no written trace is a meeting.
