{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/config/v1",
  "$ref": "#/$defs/config",
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_repository": {
          "$ref": "#/$defs/slug"
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_unclassified": {
          "type": "boolean"
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative-path"
          }
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "query_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  }
}
