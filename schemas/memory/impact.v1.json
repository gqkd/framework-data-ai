{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/impact/v1",
  "$ref": "#/$defs/impact",
  "$defs": {
    "hypotheses": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "provenance": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              },
              {
                "properties": {
                  "assertion_method": {
                    "const": "inferred"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "document_snapshot",
        "predicted",
        "mandate",
        "observed",
        "comparison",
        "hypotheses",
        "uncertainties",
        "coverage",
        "conclusion",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "framework-memory/impact/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predicted": {
          "type": "object"
        },
        "mandate": {
          "type": "object",
          "required": [
            "authorization"
          ],
          "properties": {
            "authorization": {
              "const": "not-verified"
            }
          }
        },
        "observed": {
          "type": "object"
        },
        "comparison": {
          "type": "object"
        },
        "hypotheses": {
          "$ref": "#/$defs/hypotheses"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage": {
          "enum": [
            "partial",
            "unavailable"
          ]
        },
        "conclusion": {
          "enum": [
            "structural-changes-observed",
            "no-structural-change-established-in-selected-snapshots"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "source",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "assertion_method",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "document",
            "code",
            "check"
          ]
        },
        "assertion_method": {
          "enum": [
            "declared",
            "derived",
            "inferred"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "origin_edge": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assertion_method": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "required": [
              "rationale"
            ]
          },
          "else": {
            "not": {
              "required": [
                "confidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "assertion_method": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "rule"
            ]
          }
        }
      ]
    }
  }
}
