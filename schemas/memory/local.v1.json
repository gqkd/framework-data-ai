{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/local/v1",
  "$ref": "#/$defs/local",
  "$defs": {
    "local": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkouts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/repository-id"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repository-id": {
      "type": "string",
      "pattern": "^repository:(?:product:[a-z0-9][a-z0-9-]*|platform):[a-z][a-z0-9._-]*$"
    }
  }
}
