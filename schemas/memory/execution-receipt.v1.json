{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/execution-receipt/v1",
  "$ref": "#/$defs/execution-receipt",
  "$defs": {
    "code-set": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/repository-id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit"
        ],
        "properties": {
          "repository": {
            "$ref": "#/$defs/nonempty"
          },
          "commit": {
            "$ref": "#/$defs/full-commit"
          }
        }
      }
    },
    "document-revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nonempty"
        },
        "commit": {
          "$ref": "#/$defs/full-commit"
        }
      }
    },
    "execution-receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "producer",
        "run",
        "test",
        "command",
        "document",
        "policy_hash",
        "code_set",
        "result",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "framework-memory/execution-receipt/v1"
        },
        "producer": {
          "$ref": "#/$defs/nonempty"
        },
        "run": {
          "$ref": "#/$defs/nonempty"
        },
        "test": {
          "$ref": "#/$defs/nonempty"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "document": {
          "$ref": "#/$defs/document-revision"
        },
        "policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "code_set": {
          "$ref": "#/$defs/code-set"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ]
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "full-commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "repository-id": {
      "type": "string",
      "pattern": "^repository:(?:product:[a-z0-9][a-z0-9-]*|platform):[a-z][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
