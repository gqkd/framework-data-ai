{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/contribution-input/v1",
  "$ref": "#/$defs/contribution-input",
  "$defs": {
    "contribution-input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "framework_commit",
        "author",
        "documents",
        "repositories",
        "receipts",
        "selected_tests"
      ],
      "properties": {
        "schema": {
          "const": "framework-memory/contribution-input/v1"
        },
        "framework_commit": {
          "$ref": "#/$defs/full-commit"
        },
        "author": {
          "$ref": "#/$defs/nonempty"
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "root",
            "commit",
            "approved_tip",
            "proposed"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/nonempty"
            },
            "root": {
              "$ref": "#/$defs/nonempty"
            },
            "commit": {
              "$ref": "#/$defs/full-commit"
            },
            "approved_tip": {
              "$ref": "#/$defs/full-commit"
            },
            "proposed": {
              "$ref": "#/$defs/full-commit"
            }
          }
        },
        "repositories": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/repository-id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "repository",
              "base",
              "head"
            ],
            "properties": {
              "root": {
                "$ref": "#/$defs/nonempty"
              },
              "repository": {
                "$ref": "#/$defs/nonempty"
              },
              "base": {
                "$ref": "#/$defs/full-commit"
              },
              "head": {
                "$ref": "#/$defs/full-commit"
              }
            }
          }
        },
        "receipts": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "producer",
              "run"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/nonempty"
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              },
              "producer": {
                "$ref": "#/$defs/nonempty"
              },
              "run": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        },
        "selected_tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "exception_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "request_hash"
          ],
          "properties": {
            "reviewer": {
              "$ref": "#/$defs/nonempty"
            },
            "request_hash": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "full-commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "repository-id": {
      "type": "string",
      "pattern": "^repository:(?:product:[a-z0-9][a-z0-9-]*|platform):[a-z][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
