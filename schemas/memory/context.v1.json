{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-memory/context/v1",
  "$ref": "#/$defs/context",
  "$defs": {
    "context": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "document_snapshot",
        "request",
        "evidence_products",
        "framework",
        "runtime",
        "mandate",
        "required_sources",
        "content",
        "documents",
        "graph",
        "code",
        "hypotheses",
        "issues",
        "gaps",
        "mapping_gaps",
        "delivery_complete",
        "reading_status",
        "understanding",
        "coverage",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "framework-memory/context/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request": {
          "type": "object"
        },
        "evidence_products": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        },
        "mandate": {
          "type": "object",
          "required": [
            "authorization"
          ],
          "properties": {
            "authorization": {
              "const": "not-verified"
            }
          }
        },
        "required_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required-reading"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "text",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "requirement": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "adopted-rules",
                  "source-evidence-not-executable-instructions"
                ]
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "graph": {
          "type": "object"
        },
        "code": {
          "type": "object"
        },
        "hypotheses": {
          "$ref": "#/$defs/hypotheses"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mapping_gaps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "delivery_complete": {
          "type": "boolean"
        },
        "reading_status": {
          "const": "not-attested"
        },
        "understanding": {
          "const": "not-evaluated"
        },
        "coverage": {
          "enum": [
            "available",
            "partial"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "provenance": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              },
              {
                "properties": {
                  "assertion_method": {
                    "const": "inferred"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "source",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "assertion_method",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "document",
            "code",
            "check"
          ]
        },
        "assertion_method": {
          "enum": [
            "declared",
            "derived",
            "inferred"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "origin_edge": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assertion_method": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "required": [
              "rationale"
            ]
          },
          "else": {
            "not": {
              "required": [
                "confidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "assertion_method": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "rule"
            ]
          }
        }
      ]
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "required-reading": {
      "type": "object",
      "required": [
        "id",
        "source",
        "path",
        "revision",
        "kind",
        "section",
        "start_line",
        "end_line",
        "reason",
        "node",
        "graph_path",
        "delivery",
        "reading"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/relative-path"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "document",
            "framework",
            "code"
          ]
        },
        "section": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_path": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "edge",
              "direction"
            ],
            "additionalProperties": false,
            "properties": {
              "edge": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "forward",
                  "reverse"
                ]
              }
            }
          }
        },
        "delivery": {
          "enum": [
            "included",
            "deferred",
            "missing"
          ]
        },
        "reading": {
          "const": "not-attested"
        }
      }
    }
  }
}
