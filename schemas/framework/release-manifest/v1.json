{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework/release-manifest/v1",
  "title": "release-manifest",
  "description": "Generated by schemas/generate.py from schemas/artifact-types.yaml. Do not edit by hand: run the generator.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/release-manifest/v1"
    },
    "artifact_type": {
      "const": "release-manifest"
    },
    "lifecycle": {
      "const": "immutable"
    },
    "status": {
      "enum": [
        "active"
      ]
    },
    "generated_by": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "COMMIT_HASH",
          "SHA_OF_THE_EVP_FILE"
        ]
      }
    },
    "created": {},
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "schema",
    "artifact_type",
    "lifecycle",
    "status",
    "generated_by",
    "created",
    "products"
  ]
}
