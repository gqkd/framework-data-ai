{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework/commitments/v1",
  "title": "commitments",
  "description": "Generated by schemas/generate.py from schemas/artifact-types.yaml. Do not edit by hand: run the generator.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/commitments/v1"
    },
    "artifact_type": {
      "const": "commitments"
    },
    "lifecycle": {
      "const": "living"
    },
    "status": {
      "enum": [
        "active"
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1
    },
    "created": {},
    "commitments": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "pattern": "^CMT-(\\d{3,}|NNN)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not-yet-issued",
              "stated-as-done",
              "open",
              "met",
              "renegotiated",
              "unsatisfiable"
            ]
          },
          "feasibility": {
            "enum": [
              "feasible",
              "feasible-with-reservations",
              "out-of-reach",
              "not-yet-assessable",
              "not-applicable"
            ]
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "blocked_by": {
            "type": "string",
            "minLength": 1
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "to",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "artifact_type",
    "lifecycle",
    "status",
    "owners",
    "created"
  ]
}
