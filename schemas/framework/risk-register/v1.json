          },
          "likelihood": {
            "enum": [
              "L",
              "M",
              "H"
            ]
          },
          "impact": {
            "enum": [
              "L",
              "M",
              "H"
            ]
          },
          "commitment": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
