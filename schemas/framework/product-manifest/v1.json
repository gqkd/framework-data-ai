{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework/product-manifest/v1",
  "title": "product-manifest",
  "description": "Generated by schemas/generate.py from schemas/artifact-types.yaml. Do not edit by hand: run the generator.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/product-manifest/v1"
    },
    "artifact_type": {
      "const": "product-manifest"
    },
    "lifecycle": {
      "const": "living"
    },
    "status": {
      "enum": [
        "active",
        "draft"
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1
    },
    "created": {},
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "code": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "release_relevant": {
            "type": "string",
            "minLength": 1
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "unanswerable": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "settled_by": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reason",
                "settled_by"
              ],
              "additionalProperties": false
            },
            "minProperties": 1
          }
        },
        "required": [
          "url",
          "contains"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "artifact_type",
    "lifecycle",
    "status",
    "owners",
    "created",
    "products"
  ]
}
