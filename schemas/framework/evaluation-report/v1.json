{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework/evaluation-report/v1",
  "title": "evaluation-report",
  "description": "Generated by schemas/generate.py from schemas/artifact-types.yaml. Do not edit by hand: run the generator.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "framework/evaluation-report/v1"
    },
    "artifact_type": {
      "const": "evaluation-report"
    },
    "lifecycle": {
      "const": "immutable"
    },
    "status": {
      "enum": [
        "active"
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1
    },
    "created": {},
    "verified_code": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(product|platform)\\.[a-z][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^([0-9a-f]{7,40}|COMMIT_HASH)$"
      }
    },
    "evp_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "COMMIT_HASH",
          "SHA_OF_THE_EVP_FILE"
        ]
      }
    },
    "evp_hash": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "COMMIT_HASH",
          "SHA_OF_THE_EVP_FILE"
        ]
      }
    },
    "frozen_at": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "COMMIT_HASH",
          "SHA_OF_THE_EVP_FILE"
        ]
      }
    }
  },
  "required": [
    "schema",
    "artifact_type",
    "lifecycle",
    "status",
    "owners",
    "created",
    "evp_version",
    "evp_hash",
    "frozen_at",
    "verified_code"
  ]
}
